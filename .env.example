# Bloomora Marketplace Configuration
VITE_APP_NAME=Bloomora
VITE_APP_URL=http://localhost:5173

# Supabase Credentials (leave empty or fill for live PostgreSQL backend)
# When empty or invalid, Bloomora automatically activates its fully functional,
# persisted local demo database mode so all browsing, ordering, booking, vendor
# management, and admin workflows function out of the box!
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay Test Mode Key (leave blank for built-in realistic demo sandbox checkout)
# e.g., rzp_test_xxxxxxxxxxxxxx
VITE_RAZORPAY_KEY_ID=

# Explicit Demo Mode toggle (optional: 'true' or 'false')
VITE_DEMO_MODE=true
